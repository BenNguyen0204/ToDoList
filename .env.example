# copy this file to .env and fill it in. .env is in .gitignore, never commit it.

# make a new one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# 0 on your laptop (http). leave it out on render, it defaults to on (https only)
COOKIE_SECURE=0

# set to 0 after you've made your account, so nobody else can sign up
REGISTRATION_OPEN=1
