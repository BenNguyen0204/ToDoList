# copy this file to .env and fill it in. .env is in .gitignore, never commit it.

# make a new one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# 0 on your laptop (http). leave it out on render, it defaults to on (https only)
COOKIE_SECURE=0

# set to 0 after you've made your account, so nobody else can sign up
REGISTRATION_OPEN=1

# email (brevo.com -> SMTP & API -> API keys). leave BREVO_API_KEY empty on your laptop
# and emails get printed in the flask run terminal instead of sent
BREVO_API_KEY=
# an address you verified under brevo -> Senders
MAIL_SENDER=you@example.com
MAIL_SENDER_NAME=To-do List

# secret github actions sends to /internal/send-reminders. same value goes in the repo's
# github secrets. make one with the same python command as SECRET_KEY
REMINDER_TOKEN=
